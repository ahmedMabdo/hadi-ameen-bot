# انسخ السطور دي لملف .gitignore في جذر المشروع
.env
.env.*
!.env.example
node_modules/
*.log
.DS_Store

# ملفات إعداد محلية فيها أسرار حقيقية أو خاصة بجهاز معين — القوالب بديلها في setup/
.mcp.json
.claude/settings.local.json

# ملفات تشغيل محلية (مش محتاجينها في السحابة)
*.bat
mcp-status.txt
diag-done.flag

# بايثون — bytecode متولّد من تشغيل السكربتات
__pycache__/
*.pyc
reminders.json
reminders.json.tmp

# صور مؤقتة بينزلها البوت للتحليل
tmp_images/

# حالة جلسات المحرك (Agent SDK) — حالة تشغيل محلية، مش بتترفع
sessions.json
sessions.json.tmp

# سجل استخدام المحرك (كاش/تكلفة لكل تفاعل) — حالة تشغيل محلية
logs/

# قفل الكتابة المشترك (بند 3.3) — حالة تشغيل محلية
.locks/

# فهرس الذاكرة المتدرجة (بند 4.2) — مشتق من memory.md وبيتبني بـ rebuild، مش بيترفع
knowledge/memory_index.db
knowledge/memory_index.db-wal
knowledge/memory_index.db-shm

# فهرس قاعدة المعرفة (بند 4.2 RAG) — مشتق من ملفات knowledge/، بيتبني بـ rebuild
knowledge/knowledge_index.db
knowledge/knowledge_index.db-wal
knowledge/knowledge_index.db-shm

# نتايج تشغيل الـ suite والمراجعات (بند 5.3) — حالة تشغيل. الحالات نفسها (evals/cases.json) في git
evals/runs/
evals/baseline.json
evals/review_*.md

# حالة النبضة (بند 8.1) — آخر تنبيه لكل عنصر. حالة تشغيل محلية
logs/heartbeat_state.json
logs/heartbeat_state.json.tmp

# تحصين الذاكرة + تنضيف حالة التشغيل (يوليو 2026)
*.bak-*
*.bak2-*
*.backup.*
*.pre-*
.venv/
add_key.sh
knowledge/memory_pending.jsonl
mars_results.png
mars_failed_tests.txt

# Hadi upgrade (local/generated)
ado_snapshot.db
sprint_intake_state.json
sprint_ceremonies.json
knowledge/sprints.md
*.bak
