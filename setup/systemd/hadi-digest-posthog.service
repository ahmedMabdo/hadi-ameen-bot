[Unit]
Description=Hadi digest: تقرير PostHog الصباحي (بحارس LIVE/STALE/DOWN)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/hadi-ameen-bot
EnvironmentFile=/home/ubuntu/hadi-ameen-bot/.env
ExecStart=/home/ubuntu/hadi-ameen-bot/.venv/bin/python /home/ubuntu/hadi-ameen-bot/daily_digests.py posthog
