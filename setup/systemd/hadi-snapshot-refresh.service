[Unit]
Description=Hadi ADO snapshot refresh (sprint + boards + project tree)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/hadi-ameen-bot
EnvironmentFile=/home/ubuntu/hadi-ameen-bot/.env
ExecStart=/usr/bin/python3 /home/ubuntu/hadi-ameen-bot/ado_snapshot.py refresh
