# قالب متغيرات البيئة — انسخ الملف ده لـ .env في الجذر واملا القيم الحقيقية (.env متترفعش على git).
# الريبو المدموج: البوت التفاعلي في الجذر + الروتين اليومي في intel/ — كلهم بيقروا من نفس الملف ده.

# --- Azure DevOps ---
AZURE_DEVOPS_ORG_URL=https://hadafsolutions.visualstudio.com
AZURE_DEVOPS_PAT=ضع_التوكن_هنا
AZURE_DEVOPS_DEFAULT_PROJECT=0_Projects_Team

# --- بوت الديسكورد التفاعلي (discord_bot.py) ---
DISCORD_BOT_TOKEN=ضع_توكن_بوت_هادي_هنا
# الـ user ids المسموح لها بالـ DM (مفصولة بفاصلة)
ALLOWED_USER_IDS=
# لازم لأداة قناة الـ PO (لينكات jump في وصف التذاكر)، ولازم لو البوت عضو في أكتر من سيرفر
DISCORD_GUILD_ID=
# اختياري — عدد رسايل السياق اللي بتتقرا من القناة قبل الرد (افتراضي 30)
HISTORY_LIMIT=
# اختياري — الرد على النداء بالاسم من غير مينشن ("يا هادي" / "هادي" أول الجملة).
# افتراضي on. للتعطيل: NAME_TRIGGER=off
NAME_TRIGGER=

# --- Discord follow-up routine (discord_followup.py) ---
# اختياري — لو محدد بيتخطى البحث عن القناة بالاسم
SUPPORT_CHANNEL_ID=
# اختياري — كلمة للبحث في اسم القناة (افتراضي: support / دعم / سابورت)
SUPPORT_CHANNEL_NAME=

# --- 8order-po routine (discord_orderpo.py) ---
# اختياري — افتراضيًا 1358833733699899704، حدده بس لو القناة اتغيرت
ORDERPO_CHANNEL_ID=
# اختياري — نافذة المراجعة بالساعات (افتراضي 48)
ORDERPO_WINDOW_HOURS=

# --- أداة القنوات عند الطلب (po_channel_cr.py) ---
# اختياري — قناة الـ PO، افتراضيًا 1358833733699899704
PO_CHANNEL_ID=
# اختياري — قناة مارس، افتراضيًا 1136668686044909761
MARS_CHANNEL_ID=
# اختياري — قناة 8orders-issues، افتراضيًا 1179369466279235584
ISSUES_CHANNEL_ID=
# اختياري — نوع الـ work item للـ CR (افتراضي "Change Request" — سيبه فاضي)
ADO_CR_TYPE=

# --- وضع التجربة الآمن (dry-run) ---
# للتجربة الآمنة: حط FOLLOWUP_DRY_RUN=1 (ما يبعتش في القناة العامة أبدًا).
# للتشغيل الحقيقي: شيل السطر ده تمامًا أو خليه فاضي.
FOLLOWUP_DRY_RUN=
# اختياري مع dry-run — user id تبعتله نسخة تجريبية DM خاص عشان تشوف الشكل النهائي.
FOLLOWUP_DM_USER_ID=

# --- الروتين اليومي (intel/8orders_report_generator.py — بيشتغل على Claude Code web غالبًا) ---
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
# مستلمي الـ PDF اليومي على الـ DM (id واحد أو أكتر مفصولين بفاصلة)
MAHMOUD_DISCORD_USER_ID=

# --- محرك هادي (Claude Agent SDK) — كلها اختيارية والافتراضيات شغالة ---
# sdk (الافتراضي) = Agent SDK بجلسات وحراس أمان | cli = المسار القديم (زرار رجوع فوري)
HADI_ENGINE=
# الموديل (افتراضي claude-sonnet-5)
CLAUDE_MODEL=
# أقصى عدد محادثات بتتعالج بالتوازي (افتراضي 2)
HADI_MAX_CONCURRENCY=
# عمر جلسة المحادثة بالساعات قبل ما تبدأ جلسة جديدة (افتراضي 6)
HADI_SESSION_TTL_HOURS=
# أقصى عدد أدوار أدوات للطلب الواحد (افتراضي 50)
HADI_MAX_TURNS=

# --- Prompt Caching — بند 3.1 (الكاشينج نفسه أوتوماتيك، مفيش مفتاح تشغيل) ---
# على اشتراك Claude: كاش لمدة ساعة أوتوماتيك — متحطش ENABLE_PROMPT_CACHING_1H ولا غيره.
# قاعدة صارمة: عمرك ما تحط DISABLE_PROMPT_CACHING بأي شكل هنا.
# تثبيت نسخة الـ CLI: الترقية بتكسر الكاش كله وبتعيد معالجة الجلسات المستأنفة بالكامل —
# خلي الترقية قرار مجدول (شهري) مش أوتوماتيك:
DISABLE_AUTOUPDATER=1

# --- بند 3.3 — قفل الكتابة المشترك (اختياري، الافتراضي كفاية) ---
# مهلة انتظار قفل الكتابة بالثواني قبل TimeoutError (افتراضي 60)
HADI_WRITE_LOCK_TIMEOUT=

# --- بند 3.4 — رسالة الحالة الحية (اختياري) ---
# أدنى فاصل بالثواني بين تعديلات رسالة الحالة (افتراضي 5 — احترام rate limits)
HADI_STATUS_EDIT_INTERVAL=

# --- بند 4.1/4.2 — الذاكرة المتدرجة (اختياري، الافتراضيات كفاية) ---
# عدد الملاحظات الأكثر صلة اللي بتتحقن مع كل رسالة لما الذاكرة تكبر (افتراضي 5)
HADI_MEMORY_TOP_K=
# تحت الحجم ده بالحروف بتتحقن الذاكرة كاملة زي زمان — التدرج أوتوماتيك بعديه (افتراضي 4000)
HADI_MEMORY_FULL_LIMIT=
