# قالب متغيرات البيئة — انسخ الملف ده لـ .env في الجذر واملا القيم الحقيقية (.env متترفعش على git).
# الريبو المدموج: البوت التفاعلي في الجذر + الروتين اليومي في intel/ — كلهم بيقروا من نفس الملف ده.

# --- Azure DevOps ---
AZURE_DEVOPS_ORG_URL=https://hadafsolutions.visualstudio.com
# توكن الكتابة (Work Items: Read & Write) — للإنشاء والتعليق والإرفاق
AZURE_DEVOPS_PAT=ضع_التوكن_هنا
# اختياري — توكن قراءة فقط (Work Items: Read). لو موجود، الوحدات اللي مابتكتبش
# (ado_snapshot / ado_features / ado_alerts / heartbeat) بتستخدمه بدل توكن
# الكتابة. لو سيبته فاضي كل حاجة بتشتغل زي ما هي بالتوكن الواحد.
ADO_PAT_READ=
AZURE_DEVOPS_DEFAULT_PROJECT=0_Projects_Team
# تاريخ انتهاء توكن الكتابة — بيفعّل الإنذار المبكر في discord_bot (14 يوم قبل)
AZURE_DEVOPS_PAT_EXPIRES=

# --- بوت الديسكورد التفاعلي (discord_bot.py) ---
DISCORD_BOT_TOKEN=ضع_توكن_بوت_هادي_هنا
# الـ user ids المسموح لها بالـ DM (مفصولة بفاصلة)
ALLOWED_USER_IDS=
# لازم لأداة قناة الـ PO (لينكات jump في وصف التذاكر)، ولازم لو البوت عضو في أكتر من سيرفر
DISCORD_GUILD_ID=
# اختياري — عدد رسايل السياق اللي بتتقرا من القناة قبل الرد (افتراضي 80 — F17:
# الكود كان 80 والدوكس كانت بتقول 30؛ اعتمدنا 80 لأنه سلوك الإنتاج الفعلي)
HISTORY_LIMIT=
# اختياري — الرد على النداء بالاسم من غير مينشن ("يا هادي" / "هادي" أول الجملة).
# افتراضي on. للتعطيل: NAME_TRIGGER=off
NAME_TRIGGER=

# --- Discord follow-up routine (discord_followup.py) ---
# اختياري — لو محدد بيتخطى البحث عن القناة بالاسم
SUPPORT_CHANNEL_ID=
# اختياري — كلمة للبحث في اسم القناة (افتراضي: support / دعم / سابورت)
SUPPORT_CHANNEL_NAME=

# --- 8order-po routine (discord_orderpo.py) ---
# اختياري — افتراضيًا 1358833733699899704، حدده بس لو القناة اتغيرت
ORDERPO_CHANNEL_ID=
# اختياري — نافذة المراجعة بالساعات (افتراضي 48)
ORDERPO_WINDOW_HOURS=

# --- أداة القنوات عند الطلب (po_channel_cr.py) ---
# اختياري — قناة الـ PO، افتراضيًا 1358833733699899704
PO_CHANNEL_ID=
# اختياري — قناة مارس، افتراضيًا 1136668686044909761
MARS_CHANNEL_ID=
# قناة احتياطية لتنبيهات الروتينات لو الـ DM فشل (daily_digests.py).
# سيبها فاضية = هيستخدم MARS_CHANNEL_ID. تنبيه حارس مايوصلش = حارس أعمى.
HADI_ALERT_CHANNEL_ID=
# اختياري — قناة 8orders-issues، افتراضيًا 1179369466279235584
ISSUES_CHANNEL_ID=
# اختياري — نوع الـ work item للـ CR (افتراضي "Change Request" — سيبه فاضي)
ADO_CR_TYPE=

# --- وضع التجربة الآمن (dry-run) ---
# للتجربة الآمنة: حط FOLLOWUP_DRY_RUN=1 (ما يبعتش في القناة العامة أبدًا).
# للتشغيل الحقيقي: شيل السطر ده تمامًا أو خليه فاضي.
FOLLOWUP_DRY_RUN=
# اختياري مع dry-run — user id تبعتله نسخة تجريبية DM خاص عشان تشوف الشكل النهائي.
FOLLOWUP_DM_USER_ID=

# --- الروتين اليومي (intel/8orders_report_generator.py — بيشتغل على Claude Code web غالبًا) ---
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
# مستلمي الـ PDF اليومي على الـ DM (id واحد أو أكتر مفصولين بفاصلة)
MAHMOUD_DISCORD_USER_ID=

# --- محرك هادي (Claude Agent SDK) — كلها اختيارية والافتراضيات شغالة ---
# sdk (الافتراضي) = Agent SDK بجلسات وحراس أمان | cli = المسار القديم (زرار رجوع فوري)
HADI_ENGINE=
# الموديل (افتراضي claude-sonnet-5)
CLAUDE_MODEL=
# أقصى عدد محادثات بتتعالج بالتوازي (افتراضي 2)
HADI_MAX_CONCURRENCY=
# عمر جلسة المحادثة بالساعات قبل ما تبدأ جلسة جديدة (افتراضي 6)
HADI_SESSION_TTL_HOURS=
# أقصى عدد أدوار أدوات للرد التفاعلي (افتراضي 22 — مقاس من الإنتاج: p99=17).
# الرقم القديم 50 كان 3x أعلى حالة حصلت فعلًا.
HADI_MAX_TURNS=
# وللمهام الخلفية والتقارير (افتراضي 50)
HADI_HEAVY_MAX_TURNS=

# --- Prompt Caching — بند 3.1 (الكاشينج نفسه أوتوماتيك، مفيش مفتاح تشغيل) ---
# على اشتراك Claude: كاش لمدة ساعة أوتوماتيك — متحطش ENABLE_PROMPT_CACHING_1H ولا غيره.
# قاعدة صارمة: عمرك ما تحط DISABLE_PROMPT_CACHING بأي شكل هنا.
# تثبيت نسخة الـ CLI: الترقية بتكسر الكاش كله وبتعيد معالجة الجلسات المستأنفة بالكامل —
# خلي الترقية قرار مجدول (شهري) مش أوتوماتيك:
DISABLE_AUTOUPDATER=1

# --- بند 3.3 — قفل الكتابة المشترك (اختياري، الافتراضي كفاية) ---
# مهلة انتظار قفل الكتابة بالثواني قبل TimeoutError (افتراضي 60)
HADI_WRITE_LOCK_TIMEOUT=

# --- بند 3.4 — رسالة الحالة الحية (اختياري) ---
# أدنى فاصل بالثواني بين تعديلات رسالة الحالة (افتراضي 5 — احترام rate limits)
HADI_STATUS_EDIT_INTERVAL=

# --- بند 4.1/4.2 — الذاكرة المتدرجة (اختياري، الافتراضيات كفاية) ---
# عدد الملاحظات الأكثر صلة اللي بتتحقن مع كل رسالة لما الذاكرة تكبر (افتراضي 5)
HADI_MEMORY_TOP_K=
# تحت الحجم ده بالحروف بتتحقن الذاكرة كاملة زي زمان — التدرج أوتوماتيك بعديه (افتراضي 4000)
HADI_MEMORY_FULL_LIMIT=

# --- بند 4.2 — RAG على قاعدة المعرفة (اختياري) ---
# عدد المقاطع اللي بترجع مع كل بحث (افتراضي 4)
HADI_RAG_TOP_K=
# الحجم المستهدف للمقطع بالحروف (افتراضي 900)
HADI_RAG_CHUNK=

# --- بند 5.3 — حلقة التحسين (اختياري) ---
# طول المقتطف المحفوظ من الطلب/الرد في مخزن التقييم (افتراضي 400 حرف)
HADI_EVAL_EXCERPT=

# --- حدود المرفقات (SSRF guard — 2026-07-26) ---
# hosts مسموح التنزيل منها لـ --attach-url. سيبها فاضية = مرفقات ديسكورد بس.
HADI_ATTACH_ALLOWED_HOSTS=

# --- فحوصات صحة النظام في النبضة (2026-07-26) ---
# معدل فشل التفاعلات فوقه بيتبعت تنبيه (افتراضي 5%)
HADI_HB_ERROR_PCT=
# نسبة امتلاء القرص فوقها بيتبعت تنبيه (افتراضي 90)
HADI_HB_DISK_PCT=

# --- بند 8.1/8.3 — النبضة الاستباقية (الافتراضيات محافظة عمدًا) ---
# off بيوقف النبضة بالكامل من غير تعديل كود
HADI_HEARTBEAT=
# تذكرة P0/P1 واقفة كام يوم من غير حركة تعتبر مهملة (افتراضي 3)
HADI_HB_STALE_DAYS=
# نقطة سابورت من غير رد كام ساعة (افتراضي 48)
HADI_HB_SUPPORT_HOURS=
# مايتكررش نفس التنبيه قبل كام ساعة (افتراضي 24)
HADI_HB_COOLDOWN_HOURS=
# ساعات الهدوء بتوقيت القاهرة — مفيش تنبيهات فيها (افتراضي 22 إلى 9)
HADI_HB_QUIET_START=
HADI_HB_QUIET_END=
# أقصى عدد تنبيهات في النبضة الواحدة (افتراضي 3)
HADI_HB_MAX_ALERTS=

# --- بند 9.2 — PostHog التفاعلي (اختياري) ---
# آخر حدث أقدم من كام ساعة يعتبر «متأخر» (افتراضي 2)
HADI_PH_STALE_HOURS=
# وأقدم من كام ساعة يعتبر «التتبع واقف» (افتراضي 24)
HADI_PH_DOWN_HOURS=

# --- ربط الـ Feature الأب (ado_features.py) ---
# أقل درجة نقبل عندها ربط الـ CR بفيتشر أب. تحتها بيترفع من غير parent.
# ‼ المقياس اتغير بالكامل مع ترجيح الندرة (IDF) — أي رقم قديم (0.34 / 0.95)
#   مالوش معنى دلوقتي. عاير الرقم بـ: python3 ado_features.py calibrate
#   (افتراضي 0.42 — قيمة محافظة مبدئية مش معايرة على داتاكم)
HADI_FEATURE_MIN_SCORE=
# كتلة المعلومات اللي عندها الدرجة توصل نصها (افتراضي 1.0).
# رفعه = تشدّد أكتر في «كام كلمة نادرة تكفي عشان نثق في الربط»
HADI_FEATURE_INFO_SAT=

# --- تفريغ صوت الفيديو (faster-whisper محلي — من غير نداء شبكة) ---
# 0 بيوقف التفريغ بالكامل من غير تعديل كود (افتراضي شغال)
HADI_WHISPER_ENABLED=
# حجم الموديل: tiny | base | small | medium | large-v3 (افتراضي small).
# small ~460MB وبيوازن دقة العامية المصرية مع سرعة الـ CPU.
# medium بيوصل 4-6x realtime على CPU — بطيء على مسار تفاعلي.
HADI_WHISPER_MODEL=
# cpu أو cuda (افتراضي cpu)
HADI_WHISPER_DEVICE=
# int8 على CPU، float16 على GPU (افتراضي int8)
HADI_WHISPER_COMPUTE=
# أقصى مدة بتتفرّغ من كل فيديو بالثواني (افتراضي 300 = ٥ دقايق).
# الفيديو الأطول بيتقص وبيتقال في الملاحظات إنه اتقص.
HADI_WHISPER_MAX_SECONDS=
# أقصى عدد حروف من التفريغ بيدخل البرومبت لكل فيديو (افتراضي 4000)
HADI_WHISPER_MAX_CHARS=
