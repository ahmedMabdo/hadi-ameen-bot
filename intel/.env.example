POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=

ADO_ORG=https://hadafsolutions.visualstudio.com
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_ORG_URL=https://hadafsolutions.visualstudio.com/0_Projects_Team/_sprints/taskboard/Mars%20Team/0_Projects_Team/Mars_Cycle/MS-91
AZURE_DEVOPS_DEFAULT_PROJECT=0_Projects_Team

# Ticket destination is fixed in ado_client.py regardless of the taskboard URL above:
#   Project=0_Projects_Team, Team/AreaPath=Support Team, board=Stories.
ADO_PROJECT=0_Projects_Team
ADO_AREA_PATH=0_Projects_Team\Support Team

# Discord delivery (discord_delivery.py) — sends the generated business PDF
# as a DM at the end of every routine run. Same bot token used for interactive access.
DISCORD_BOT_TOKEN=
# Preferred: recipient Discord user id(s) (snowflakes), set once. Accepts ONE
# id, or several separated by commas and/or spaces — each gets its own DM,
# e.g. to send to both Mahmoud and yourself for confirmation:
#   MAHMOUD_DISCORD_USER_ID=111111111111111111,222222222222222222
MAHMOUD_DISCORD_USER_ID=
# Fallback only: if MAHMOUD_DISCORD_USER_ID is unset, resolve a single
# recipient by searching this guild's members for "Mahmoud Abdou"
# (requires Server Members Intent).
DISCORD_GUILD_ID=

# PO channel -> Change Requests bridge (po_channel_cr.py, used by Hadi on AWS).
# Reuses DISCORD_BOT_TOKEN + AZURE_DEVOPS_PAT above; DISCORD_GUILD_ID is used
# for message jump links in CR descriptions. All three below are optional
# overrides of the defaults shown:
PO_CHANNEL_ID=1358833733699899704
MARS_CHANNEL_ID=1136668686044909761
ADO_CR_AREA_PATH=0_Projects_Team\Change Requests
ADO_CR_TYPE=Issue
