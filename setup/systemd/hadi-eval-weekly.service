[Unit]
Description=Hadi weekly evals report (judge + DM to Asser)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/hadi-ameen-bot
EnvironmentFile=/home/ubuntu/hadi-ameen-bot/.env
ExecStart=/home/ubuntu/hadi-ameen-bot/.venv/bin/python /home/ubuntu/hadi-ameen-bot/eval_report.py send --days 7 --with-judge
