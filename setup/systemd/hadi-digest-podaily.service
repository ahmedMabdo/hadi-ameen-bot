[Unit]
Description=Hadi digest: ملخص قناة الـ PO اليومي
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/hadi-ameen-bot
EnvironmentFile=/home/ubuntu/hadi-ameen-bot/.env
ExecStart=/usr/bin/python3 /home/ubuntu/hadi-ameen-bot/daily_digests.py podaily
